# Private Worker-to-Container authentication (required)
INTERNAL_CONTAINER_SECRET=replace-with-a-long-random-value

# Telegram Bot API (required for direct delivery)
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# HTTPS origin; loopback HTTP is allowed only for local Bot API development.
TELEGRAM_BOT_API_BASE=https://api.telegram.org

# Fixed binary paths in the image; keep these explicit.
DENO_PATH=/usr/local/bin/deno
YT_DLP_PATH=/app/.venv/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Source policy. Use an explicit list; ALLOW_UNLISTED_HOSTS must remain false.
ALLOWED_SOURCE_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be,instagram.com,www.instagram.com,tiktok.com,www.tiktok.com,vm.tiktok.com,vt.tiktok.com,x.com,www.x.com,twitter.com,www.twitter.com,vimeo.com,www.vimeo.com,player.vimeo.com,reddit.com,www.reddit.com,old.reddit.com,np.reddit.com,nm.reddit.com,redditmedia.com,www.redditmedia.com,pinterest.com,www.pinterest.com,pinterest.ca,www.pinterest.ca,co.pinterest.com,www.ted.com,embed.ted.com,embed-ssl.ted.com
ALLOW_UNLISTED_HOSTS=false
RESOLVE_SOURCE_DNS=true

# Limits
MAX_URL_LENGTH=2048
MAX_DURATION_SECONDS=7200
MAX_SOURCE_DOWNLOAD_BYTES=500000000
MAX_TEMP_DISK_BYTES=1000000000
TELEGRAM_UPLOAD_LIMIT_BYTES=49000000
# Telegram URL-fetch path (sendVideo with a provider URL) is capped at 20 MB.
TELEGRAM_URL_LIMIT_BYTES=20000000
DIRECT_RESOLVER_TIMEOUT_SECONDS=15
DIRECT_RESOLVER_RETRIES=5
# Absolute cap for each individual /v1/jobs/run or /v1/jobs/deliver request.
JOB_TIMEOUT_SECONDS=1200
DOWNLOAD_TIMEOUT_SECONDS=1200
PROBE_TIMEOUT_SECONDS=90
FFMPEG_TIMEOUT_SECONDS=600
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=600

# Private R2 fallback. Never commit real values.
# HTTPS origin; loopback HTTP is allowed only for local development.
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_BUCKET=private-media
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key # gitleaks:allow -- placeholder only
# HTTPS origin only, including local deployments (it is embedded in signed links).
PUBLIC_WORKER_BASE_URL=https://worker.example.invalid
DOWNLOAD_LINK_HMAC_SECRET=replace-with-a-long-random-value
