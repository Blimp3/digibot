{
  "name": "private-media-downloader-worker",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --containers-rollout none",
    "types": "wrangler types --env-file /dev/null",
    "typecheck": "wrangler types --check --env-file /dev/null && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.34.0",
    "typescript-eslint": "^8.40.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.32.0"
  }
}
