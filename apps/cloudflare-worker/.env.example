# Non-secret local variables. Put secrets in .dev.vars (never commit it).
ALLOWED_SOURCE_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be,instagram.com,www.instagram.com,tiktok.com,www.tiktok.com,vm.tiktok.com,vt.tiktok.com,x.com,www.x.com,twitter.com,www.twitter.com,vimeo.com,www.vimeo.com,player.vimeo.com,reddit.com,www.reddit.com,old.reddit.com,np.reddit.com,nm.reddit.com,redditmedia.com,www.redditmedia.com,pinterest.com,www.pinterest.com,pinterest.ca,www.pinterest.ca,co.pinterest.com,www.ted.com,embed.ted.com,embed-ssl.ted.com
DEFAULT_MAX_HEIGHT=1080
MAX_REQUEST_BODY_BYTES=16384
MAX_MEDIA_DURATION_SECONDS=7200
MAX_SOURCE_BYTES=524288000
MAX_TEMP_DISK_BYTES=1000000000
MAX_TELEGRAM_BYTES=49000000
MAX_URL_LENGTH=2048
DOWNLOAD_TIMEOUT_SECONDS=1200
PROBE_TIMEOUT_SECONDS=90
FFMPEG_TIMEOUT_SECONDS=600
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=600
PROCESS_TERM_GRACE_SECONDS=10
MAX_RETRIES=2
STRICT_DEPENDENCIES=true
MAX_JOBS_PER_HOUR=20
# Global bot-wide active-job cap; MAX_JOBS_PER_HOUR remains per user.
MAX_ACTIVE_JOBS=1
# Dedicated transcript lane cap; transcript requests do not consume source slots.
MAX_ACTIVE_TRANSCRIPTIONS=1
JOB_TIMEOUT_SECONDS=1200
# Transcript requests are bounded to 15 minutes of media and 30 minutes of work.
MAX_TRANSCRIPT_DURATION_SECONDS=900
TRANSCRIPTION_TIMEOUT_SECONDS=1800
R2_LINK_TTL_SECONDS=3600
R2_RETENTION_SECONDS=86400
PUBLIC_WORKER_BASE_URL=https://replace-with-worker.example
TELEGRAM_BOT_API_BASE=https://api.telegram.org
R2_BUCKET_NAME=replace-with-private-bucket
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com

# Set the D1/R2 identifiers in wrangler.jsonc or an environment-specific file.
